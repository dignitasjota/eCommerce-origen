model AuditLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  user_id     String?  @db.VarChar(36)
  /// Acción ejecutada: "product.create", "order.update_status", etc.
  action      String   @db.VarChar(100)
  /// Tipo de entidad afectada ("Product", "Order", ...).
  entity_type String   @db.VarChar(50)
  entity_id   String?  @db.VarChar(36)
  /// JSON con detalles relevantes (campos cambiados, antes/después).
  metadata    String?  @db.LongText
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now())

  @@index([user_id], map: "idx_audit_user")
  @@index([entity_type, entity_id], map: "idx_audit_entity")
  @@index([created_at], map: "idx_audit_created")
  @@map("audit_logs")
}

model StockMovement {
  id           String              @id @default(uuid()) @db.VarChar(36)
  variant_id   String              @db.VarChar(36)
  /// Cantidad: positiva (entrada) o negativa (salida).
  quantity     Int
  /// Razón del movimiento — útil para auditar discrepancias de stock.
  reason       StockMovementReason
  /// Referencia opcional al pedido / devolución / ajuste origen.
  reference_id String?             @db.VarChar(36)
  note         String?             @db.VarChar(255)
  user_id      String?             @db.VarChar(36)
  created_at   DateTime            @default(now())

  @@index([variant_id], map: "idx_stock_variant")
  @@index([reason], map: "idx_stock_reason")
  @@index([created_at], map: "idx_stock_created")
  @@map("stock_movements")
}

enum StockMovementReason {
  PURCHASE
  REFUND
  ADJUSTMENT
  RESTOCK
  RESERVATION_RELEASE
}

model Subscriber {
  id           String    @id @default(uuid()) @db.VarChar(36)
  email        String    @unique(map: "uq_subscriber_email") @db.VarChar(255)
  locale       String    @default("es") @db.VarChar(5)
  /// Token HMAC para confirmar la suscripción (doble opt-in). Se invalida al confirmar.
  confirm_token String?  @unique(map: "uq_subscriber_token") @db.VarChar(255)
  confirmed_at DateTime?
  unsubscribed_at DateTime?
  created_at   DateTime  @default(now())

  @@index([confirmed_at], map: "idx_subscribers_confirmed")
  @@map("subscribers")
}

/// Contador correlativo de facturación por (serie, año).
/// Garantiza numeración estrictamente secuencial sin huecos — requisito
/// fiscal en España (AEAT/Veri*Factu) y otras jurisdicciones UE.
///
/// Patrón de uso: UPSERT atómico que devuelve el siguiente número:
///   const counter = await tx.invoiceCounter.upsert({
///     where: { series_year: { series, year } },
///     update: { last_number: { increment: 1 } },
///     create: { series, year, last_number: 1 }
///   });
///   const invoiceNumber = `${series}-${year}-${String(counter.last_number).padStart(7, '0')}`;
///
/// La serie por defecto se configura en SiteSetting `invoice_series` (ej. 'A').
/// Tiendas multi-sociedad pueden usar series distintas (A, B, EXP...) según
/// criterio fiscal.
model InvoiceCounter {
  id          String @id @default(uuid()) @db.VarChar(36)
  series      String @db.VarChar(10)
  year        Int
  last_number Int    @default(0)

  @@unique([series, year], map: "uq_invoice_series_year")
  @@map("invoice_counters")
}

model WebhookEvent {
  id           String   @id @default(uuid()) @db.VarChar(36)
  provider     String   @db.VarChar(50)
  event_id     String   @db.VarChar(255)
  event_type   String?  @db.VarChar(100)
  processed_at DateTime @default(now())

  @@unique([provider, event_id], map: "uq_webhook_provider_event")
  @@index([provider], map: "idx_webhook_provider")
  @@map("webhook_events")
}

model RelatedProduct {
  id                 String       @id @default(uuid()) @db.VarChar(36)
  product_id         String       @db.VarChar(36)
  related_product_id String       @db.VarChar(36)
  relation_type      RelationType
  created_at         DateTime     @default(now())

  product         Product @relation("RelatedToProduct", fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "related_products_ibfk_1")
  related_product Product @relation("RelatedFromProduct", fields: [related_product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "related_products_ibfk_2")

  @@unique([product_id, related_product_id], map: "uq_product_related")
  @@index([product_id], map: "idx_related_product")
  @@index([related_product_id], map: "idx_related_from_product")
  @@map("related_products")
}
