{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/(storefront)/layout,_N_T_/[locale]/(storefront)/cart/layout,_N_T_/[locale]/(storefront)/cart/page,_N_T_/en/cart"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/!KHN0b3JlZnJvbnQp/cart/__PAGE__",
    "/$d$locale/!KHN0b3JlZnJvbnQp/cart",
    "/$d$locale/!KHN0b3JlZnJvbnQp",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}